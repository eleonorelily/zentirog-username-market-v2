rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email == 'zormogo@gmail.com'
          || request.auth.uid == 'nddx1x2m1dTp9ZgfBJkvzcVy1SE3'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function usernameShape(data) {
      return data.keys().hasOnly([
        'username',
        'price',
        'description',
        'category',
        'credentials',
        'isNew',
        'isHot',
        'isSold',
        'isBest4',
        'priority',
        'public',
        'createdAt',
        'updatedAt',
        'createdAtServer',
        'updatedAtServer'
      ])
      && data.username is string
      && data.username.matches('^@[A-Za-z0-9_.]{1,32}$')
      && data.price is string
      && data.description is string
      && data.category is string
      && (!('credentials' in data) || data.credentials is string)
      && data.isNew is bool
      && data.isHot is bool
      && data.isSold is bool
      && data.public is bool
      && data.priority in ['none', 'high', 'mid', 'low'];
    }

    match /admins/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false;
    }

    match /usernames/{usernameId} {
      allow list: if isAdmin() || resource.data.public == true;
      allow get: if isAdmin() || resource.data.public == true;
      allow create: if isAdmin() && usernameShape(request.resource.data);
      allow update: if (isAdmin() && usernameShape(request.resource.data))
        || (
          // Allow serverless order fulfillment to mark a username as sold
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isSold', 'price'])
          && request.resource.data.isSold == true
          && resource.data.isSold == false
          && (request.resource.data.price == 'SOLD' || request.resource.data.price == 'CLAIMED')
        );
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if settingId == 'config' || settingId == 'discounts';
      allow write: if isAdmin()
        || (
          // Allow serverless checkout to increment usedCount on discounts
          settingId == 'discounts'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['codes', 'updatedAt', 'updatedAtServer'])
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
